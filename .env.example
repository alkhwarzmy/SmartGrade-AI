SMARTGRADE_DATA_DIR=storage
# Local OCR: tesseract baseline (default) or manual. Requires Tesseract executable.
OCR_PROVIDER=tesseract
# Remote JSON chat-completions-compatible LLM. No requests by default.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
ALLOW_EXTERNAL_AI=false
ALLOW_PAID_API=false
