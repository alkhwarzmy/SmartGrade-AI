SMARTGRADE_MODE=commercial
# Demo is unauthenticated and must only use synthetic data.
SMARTGRADE_DATA_DIR=storage
# Local OCR: tesseract baseline (default) or manual. Requires Tesseract executable.
OCR_PROVIDER=tesseract
# Remote JSON chat-completions-compatible LLM. No requests by default.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
ALLOW_EXTERNAL_AI=false
ALLOW_PAID_API=false

# Enable API documentation only in a trusted development environment.
SMARTGRADE_API_DOCS=false
# Required by Compose for HTTPS; set a domain you own and configure DNS.
SMARTGRADE_DOMAIN=
# Bound OpenCV workers on CPU/container installations (1..8).
SMARTGRADE_CV_THREADS=2

# API accepts the overwritten client-IP header only from these transport peers.
# Compose uses the fixed Caddy address. For direct localhost development leave empty.
SMARTGRADE_TRUSTED_PROXY_CIDRS=
# Readiness fails below this free disk reserve.
SMARTGRADE_MIN_FREE_MB=64
